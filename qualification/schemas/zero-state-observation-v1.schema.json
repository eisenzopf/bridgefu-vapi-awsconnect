{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bridgefu.dev/vapi-awsconnect/qualification/zero-state-observation-v1.schema.json",
  "title": "Disposable qualification teardown observation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer", "producer_revision_sha256", "execution_id", "observed_at", "customer_stack_absent", "connect_instance_absent", "temporary_vapi_resources_absent", "test_credentials_absent", "qualification_objects_absent", "qualification_private_dns_absent", "qualification_acm_validation_records_absent", "all_resource_classes_absent", "three_observations_spanning_60_seconds", "zero_resource_proof_sha256", "redacted"],
  "properties": {
    "schema_version": {"const": 1},
    "producer": {"const": "bridgefu-vapi-awsconnect-qualification@1"},
    "producer_revision_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "execution_id": {"type": "string", "pattern": "^bfq-[a-z0-9-]{4,28}$"},
    "observed_at": {"type": "string", "format": "date-time"},
    "customer_stack_absent": {"const": true},
    "connect_instance_absent": {"const": true},
    "temporary_vapi_resources_absent": {"const": true},
    "test_credentials_absent": {"const": true},
    "qualification_objects_absent": {"const": true},
    "qualification_private_dns_absent": {"const": true},
    "qualification_acm_validation_records_absent": {"const": true},
    "all_resource_classes_absent": {"const": true},
    "three_observations_spanning_60_seconds": {"const": true},
    "zero_resource_proof_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "redacted": {"const": true}
  }
}
